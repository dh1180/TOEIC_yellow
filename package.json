{
  "name": "toeic-yellow",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --test tests/*.test.js",
    "typecheck": "echo 'JavaScript project: static data and functional tests run via npm test'",
    "check": "npm test && npm run audit:content",
    "restore:icon": "node scripts/restore-icon.mjs",
    "audit:content": "python3 scripts/audit_content.py --write",
    "release:check": "npm run check && node scripts/check-release.mjs",
    "eas-build-post-install": "node scripts/eas-release-gate.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^58.0.23",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "type": "module"
}
